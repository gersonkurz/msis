<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!--
    WiX Bundle (Bootstrapper) Template
    Generated by msis-3.x

    Install folder and feature selection are handled by the individual MSI packages.
  -->

  <Bundle Name="{{PRODUCT_NAME}}" Version="{{PRODUCT_VERSION}}" Manufacturer="{{MANUFACTURER}}" UpgradeCode="{{UPGRADE_CODE}}">

    <!-- Default install folder for bundle options UI -->
    <Variable Name="InstallFolder" Type="string" Value="" bal:Overridable="yes"/>
    <SetVariable Id="SetInstallFolder" Variable="InstallFolder"
        Value="[ProgramFiles6432Folder]{{#if INSTALL_FOLDER}}{{INSTALL_FOLDER}}{{else}}{{#if INSTALLDIR}}{{INSTALLDIR}}{{else}}{{PRODUCT_NAME}}{{/if}}{{/if}}"/>

    {{#if LAUNCH_TARGET}}
    <!-- Show a "Launch" button on the WixStdBA success page (LAUNCH_TARGET is a Formatted path) -->
    <Variable Name="LaunchTarget" Value="{{LAUNCH_TARGET}}"/>
    {{/if}}

    <!-- Detect VC++ 2015-2022 runtime (referenced by Prereq_vcredist_* DetectCondition) -->
    <util:RegistrySearch Id="VcppRuntimeX64" Variable="VcppRuntimeX64Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Value="Installed"
        Result="exists" Bitness="always64"/>
    <util:RegistrySearch Id="VcppRuntimeX86" Variable="VcppRuntimeX86Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86" Value="Installed"
        Result="exists" Bitness="always32"/>

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseUrl="{{LICENSE_URL}}"{{#if LOGO_BOOTSTRAP}} LogoFile="{{LOGO_BOOTSTRAP}}"{{/if}} Theme="hyperlinkLicense" SuppressOptionsUI="yes"/>
    </BootstrapperApplication>

    <Chain>
{{{CHAIN}}}
    </Chain>

  </Bundle>
</Wix>
