<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!--
    WiX Bundle (Bootstrapper) Template
    Generated by msis-3.x

    Install folder and feature selection are handled by the individual MSI packages.
  -->

  <Bundle Name="{{PRODUCT_NAME}}" Version="{{PRODUCT_VERSION}}" Manufacturer="{{MANUFACTURER}}" UpgradeCode="{{UPGRADE_CODE}}">

    <!-- Default install folder for bundle options UI -->
    <Variable Name="InstallFolder" Type="string" Value="" bal:Overridable="yes"/>

    <!-- Resolve the *true* 64-bit Program Files. The bundle's Burn engine is x86 (so the
         bundle runs on x86 Windows too), but an x86 engine mis-resolves
         [ProgramFiles6432Folder] on ARM64 Windows, which put the LaunchTarget path in the
         wrong place there. Reading ProgramFilesDir from the 64-bit registry view (always64)
         yields C:\Program Files on both x64 and ARM64 — matching where the MSI installs. -->
    <util:RegistrySearch Id="ProgramFiles64Dir" Variable="ProgramFiles64Dir"
        Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion" Value="ProgramFilesDir"
        Result="value" Bitness="always64"/>

    <!-- Program Files root, normalized to include a trailing slash. Default is the built-in
         (correct on 32-bit and x64 Windows). On 64-bit Windows the registry value is found and
         we override with it, which fixes ARM64 and is identical to the default on x64. -->
    <SetVariable Id="SetPfRoot" Variable="PfRoot" Value="[ProgramFiles6432Folder]"/>
    <SetVariable Id="SetPfRootNative" Variable="PfRoot" After="SetPfRoot"
        Condition="ProgramFiles64Dir" Value="[ProgramFiles64Dir]\"/>

    <SetVariable Id="SetInstallFolder" Variable="InstallFolder" After="SetPfRootNative"
        Value="[PfRoot]{{#if INSTALL_FOLDER}}{{INSTALL_FOLDER}}{{else}}{{#if INSTALLDIR}}{{INSTALLDIR}}{{else}}{{PRODUCT_NAME}}{{/if}}{{/if}}"/>

    {{#if LAUNCH_TARGET}}
    <!-- Show a "Launch" button on the WixStdBA success page (LAUNCH_TARGET is a Formatted path) -->
    <Variable Name="LaunchTarget" Value="{{LAUNCH_TARGET}}"/>
    {{/if}}

    <!-- Detect VC++ 2015-2022 runtime (referenced by Prereq_vcredist_* DetectCondition) -->
    <util:RegistrySearch Id="VcppRuntimeX64" Variable="VcppRuntimeX64Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Value="Installed"
        Result="exists" Bitness="always64"/>
    <util:RegistrySearch Id="VcppRuntimeX86" Variable="VcppRuntimeX86Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86" Value="Installed"
        Result="exists" Bitness="always32"/>

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseUrl="{{LICENSE_URL}}"{{#if LOGO_BOOTSTRAP}} LogoFile="{{LOGO_BOOTSTRAP}}"{{/if}} Theme="hyperlinkLicense" SuppressOptionsUI="yes"/>
    </BootstrapperApplication>

    <Chain>
{{{CHAIN}}}
    </Chain>

  </Bundle>
</Wix>
