<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!--
    WiX Bundle (Bootstrapper) Template - Silent Mode
    Generated by msis-3.x

    For unattended deployment: no license unless LICENSE_URL is set, no Options button, and the
    chained MSI shows no UI of its own (msis drops its DisplayInternalUICondition, #95, D31). It
    runs the standard bootstrapper, so it is silent when started with /quiet (no UI) or /passive
    (progress only):
      setup.exe /quiet /norestart
    The install folder is the MSI's default; the bundle does not forward INSTALLDIR to the MSI.
  -->

  <Bundle Name="{{PRODUCT_NAME}}" Version="{{PRODUCT_VERSION}}" Manufacturer="{{MANUFACTURER}}" UpgradeCode="{{UPGRADE_CODE}}"{{#if MANUFACTURER_URL}} AboutUrl="{{MANUFACTURER_URL}}"{{/if}}>

    <!-- Default install folder for bundle -->
    <Variable Name="InstallFolder" Type="string" Value="" bal:Overridable="yes"/>
    <SetVariable Id="SetInstallFolder" Variable="InstallFolder"
        Value="[ProgramFiles6432Folder]{{#if INSTALL_FOLDER}}{{INSTALL_FOLDER}}{{else}}{{#if INSTALLDIR}}{{INSTALLDIR}}{{else}}{{PRODUCT_NAME}}{{/if}}{{/if}}"/>

    <!-- Detect VC++ 2015-2022 runtime (referenced by Prereq_vcredist_* DetectCondition) -->
    <util:RegistrySearch Id="VcppRuntimeX64" Variable="VcppRuntimeX64Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Value="Installed"
        Result="exists" Bitness="always64"/>
    <util:RegistrySearch Id="VcppRuntimeX86" Variable="VcppRuntimeX86Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86" Value="Installed"
        Result="exists" Bitness="always32"/>
    <util:RegistrySearch Id="VcppRuntimeArm64" Variable="VcppRuntimeArm64Installed"
        Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\arm64" Value="Installed"
        Result="exists" Bitness="always64"/>

    <!-- The script's <search> elements (#90, decisions D30): registry searches setting Burn variables for <exe detect> -->
{{{SEARCHES}}}
    <BootstrapperApplication>
      <!-- A built-in theme, not Theme="none": "none" ships no theme, and the standard bootstrapper
           cannot start without one (0x80070490, #95). -->
      <bal:WixStandardBootstrapperApplication LicenseUrl="{{LICENSE_URL}}" Theme="hyperlinkLicense" SuppressOptionsUI="yes"/>
    </BootstrapperApplication>

    <Chain>
{{{CHAIN}}}
    </Chain>

  </Bundle>
</Wix>
