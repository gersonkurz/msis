<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIS Self-Packaging Setup (x64)
  Installs msis.exe to Program Files, templates to LocalAppData

  Build with: just release (x64) or just release-all, which first write the component
  documents the <sbom> elements below name
-->
<setup>
  <!-- Product identification -->
  <set name="PRODUCT_NAME" value="MSIS"/>
  <set name="PRODUCT_VERSION" value="3.0.3"/>
  <set name="MANUFACTURER" value="NG Branch Technology GmbH"/>
  <set name="UPGRADE_CODE" value="{E7A3B8C1-5D2F-4A9E-B6C4-8F1D3E2A7B5C}"/>

  <!-- Who made msis, and who produced its SBOMs (#64): written into the installer and read back
       by /SBOM. A URL, not an email: BSI TR-03183-2 accepts one when no email is given. -->
  <set name="MANUFACTURER_URL" value="https://github.com/gersonkurz/msis"/>
  <set name="SBOM_CREATOR" value="https://github.com/gersonkurz/msis"/>
  <!-- The licence msis's own SBOMs are offered under (#62; see README "SBOM"). -->
  <set name="SBOM_DATA_LICENSE" value="CC0-1.0"/>

  <!-- Allow user to select install folder -->
  <set name="INSTALL_DIR_DIALOG" value="true"/>

  <!-- Build configuration -->
  <set name="PLATFORM" value="x64"/>
  <set name="BUILD_TARGET" value="dist\msis-{{PRODUCT_VERSION}}-{{PLATFORM}}.msi"/>

  <!-- Install folder name (under Program Files) -->
  <set name="INSTALLDIR" value="MSIS"/>

  <!-- Add install directory to PATH -->
  <set name="ADD_TO_PATH" value="True"/>

  <!-- License -->
  <set name="LICENSE_URL" value="https://github.com/gersonkurz/msis/blob/main/LICENSE"/>

  <!-- What is inside the files msis cannot see into, composed into this MSI's own SBOM (#36).
       `just sbom-components` writes them, and the release recipes copy the document for the
       architecture being packaged to msis.exe.cdx.json beside msis.exe. msis checks each
       document's SHA-256 against the packaged file, so a stale one fails the build. -->
  <sbom source="dist\components\msis.exe.cdx.json" for="[INSTALLDIR]msis.exe"/>
  <sbom source="dist\components\msi-simplica-x64.dll.cdx.json" for="[LOCALAPPDATADIR]templates\x64\msi-simplica.dll"/>
  <sbom source="dist\components\msi-simplica-x86.dll.cdx.json" for="[LOCALAPPDATADIR]templates\x86\msi-simplica.dll"/>
  <sbom source="dist\components\msi-simplica-arm64.dll.cdx.json" for="[LOCALAPPDATADIR]templates\arm64\msi-simplica.dll"/>

  <!-- Who made the other files this installer carries, and under which licence (#65). A file
       may be described once only, so the folders holding a hook DLL (described above) are
       declared file by file. No version: these files have none of their own, and /BUILD /SBOM
       gives them their modification date (decisions D15). -->
  <component for="[LOCALAPPDATADIR]templates\" recursive="no" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <component for="[LOCALAPPDATADIR]templates\minimal\" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <component for="[LOCALAPPDATADIR]templates\minimal-x86\" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <component for="[LOCALAPPDATADIR]templates\x64\template.wxs" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <component for="[LOCALAPPDATADIR]templates\x86\template.wxs" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <component for="[LOCALAPPDATADIR]templates\x86\template-silent.wxs" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <component for="[LOCALAPPDATADIR]custom\" creator="https://github.com/gersonkurz/msis" license="MIT"/>
  <!-- The WiX UI localisation files are WiX's: "Copyright (c) .NET Foundation and contributors ...
       Licensed under the Microsoft Reciprocal License", as each file's header says. -->
  <component for="[LOCALAPPDATADIR]templates\wixlib\" creator="https://wixtoolset.org" license="MS-RL"/>

  <!-- Main feature -->
  <feature name="MSIS">
    <!-- Executable to Program Files\MSIS -->
    <files source="msis.exe" target="[INSTALLDIR]"/>

    <!-- Templates to %LOCALAPPDATA%\MSIS\templates (LOCALAPPDATADIR inherits INSTALLDIR=MSIS).
         The x64/x86/arm64 folders also carry the native hook DLL (msi-simplica.dll) staged by
         `just build-hooks`; arm64 holds only the DLL (arm64 builds use the x64 template). -->
    <files source="..\templates\x64" target="[LOCALAPPDATADIR]templates\x64"/>
    <files source="..\templates\x86" target="[LOCALAPPDATADIR]templates\x86"/>
    <files source="..\templates\arm64" target="[LOCALAPPDATADIR]templates\arm64"/>
    <files source="..\templates\minimal" target="[LOCALAPPDATADIR]templates\minimal"/>
    <files source="..\templates\minimal-x86" target="[LOCALAPPDATADIR]templates\minimal-x86"/>
    <files source="..\templates\bundle.wxs" target="[LOCALAPPDATADIR]templates"/>
    <files source="..\templates\bundle-silent.wxs" target="[LOCALAPPDATADIR]templates"/>
    <files source="..\templates\wixlib" target="[LOCALAPPDATADIR]templates\wixlib"/>

    <!-- Create empty custom folder for user templates -->
    <files source="..\templates\custom" target="[LOCALAPPDATADIR]custom"/>
  </feature>
</setup>
