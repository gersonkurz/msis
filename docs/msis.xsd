<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation>
      msis schema for msis-2.x and msis-3.x.
      Based on DescriptionReader.cs (2.x) and internal/parser (3.x).
      This captures tag inventory and attribute names; values are minimally constrained.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="msisBoolean">
    <xs:restriction base="xs:string">
      <xs:pattern value="([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|[Yy][Ee][Ss]|[Nn][Oo]|[Oo][Nn]|[Oo][Ff][Ff]|1|0)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="SetType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="FilesType">
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="target" type="xs:string" use="required"/>
    <xs:attribute name="do-not-overwrite" type="msisBoolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="RegistryType">
    <xs:attribute name="file" type="xs:string" use="required"/>
    <xs:attribute name="sddl" type="xs:string" use="optional"/>
    <xs:attribute name="preserve" type="msisBoolean" use="optional">
      <xs:annotation>
        <xs:documentation>
          "yes" keeps a value the machine already has, writing the value from the .reg file
          only where none exists. Use it for settings a user may have changed.

          Not applied to QWORDs, expandable strings or multi-strings, which are always written
          from the .reg file, nor to a value whose content starts with "[" (an MSI Formatted
          expression resolved at install time).

          An existing but EMPTY value is also NOT preserved: the .reg default overwrites it.
          The search runs and reads the empty value, but AppSearch makes no assignment from an
          empty result, so the property keeps the .reg default it was initialised with. "Found,
          but empty" is therefore indistinguishable from "not found". See docs/tutorial.md and
          issue #26.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="permanent" type="msisBoolean" use="optional"/>
    <xs:attribute name="condition" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="SetEnvType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ShortcutType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="target" type="xs:string" use="required"/>
    <xs:attribute name="file" type="xs:string" use="required"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:attribute name="icon" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ServiceType">
    <xs:attribute name="file-name" type="xs:string" use="required"/>
    <xs:attribute name="service-name" type="xs:string" use="required"/>
    <xs:attribute name="service-display-name" type="xs:string" use="optional"/>
    <xs:attribute name="start" type="xs:string" use="optional"/>
    <xs:attribute name="description" type="xs:string" use="optional"/>
    <xs:attribute name="service-type" type="xs:string" use="optional"/>
    <xs:attribute name="error-control" type="xs:string" use="optional"/>
    <xs:attribute name="restart" type="xs:string" use="optional"/>
    <xs:attribute name="start-after-install" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ExcludeType">
    <xs:attribute name="folder" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="CreateFolderType">
    <xs:annotation>
      <xs:documentation>
        Creates an empty directory at install time, e.g. a log or data folder the
        application writes to later. The directory is removed on uninstall only if it is
        still empty; use remove-on-uninstall to delete one with content.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="target" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Directory to create, as a root key plus a subpath: [APPDATADIR]MyCompany\Logs.
          A path matching no known root is treated as a subpath of INSTALLDIR.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="RemoveOnUninstallType">
    <xs:annotation>
      <xs:documentation>
        Removes a folder tree or a registry key on uninstall, including content the
        installer never installed.

        Both attributes may be set on one element; each is emitted as its own component and
        applied independently, so it is equivalent to writing two elements. An element with
        neither attribute produces nothing.

        DESTRUCTIVE. folder deletes the directory and everything under it (WiX
        util:RemoveFolderEx), which includes files the application or the user created
        there, such as databases and logs. registry deletes the key and all of its
        subkeys and values. Point both at a directory or key the package owns.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="folder" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          Folder to delete recursively, e.g. [APPDATADIR]MyCompany\MyApp. Resolved at
          install time and recorded in the registry, so the path is known at uninstall.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="registry" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          Registry key to delete recursively, as root plus key:
          HKLM\Software\MyCompany\MyApp. Recognized roots are HKLM, HKCU, HKCR and HKU, or
          their long forms (HKEY_LOCAL_MACHINE etc.). A root msis does not recognize is
          skipped silently: the package builds and the key is never removed.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ExecuteType">
    <xs:attribute name="cmd" type="xs:string" use="required"/>
    <xs:attribute name="when" type="xs:string" use="required"/>
    <xs:attribute name="directory" type="xs:string" use="optional"/>
    <xs:attribute name="fail-on-error" type="msisBoolean" use="optional"/>
    <xs:attribute name="quiet" use="optional">
      <xs:annotation>
        <xs:documentation>
          Controls whether the launched process shows a console window.
          "no" (default): visible console window (current behavior).
          "yes": always hidden, run via WixQuietExec (CREATE_NO_WINDOW); output is captured to the MSI log.
          "auto": hidden only for unattended installs (UILevel &lt;= 3, i.e. /qn or /qb); visible otherwise.
          Only supported for deferred timings (not when="before-install").
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="no"/>
          <xs:enumeration value="yes"/>
          <xs:enumeration value="auto"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="PrerequisiteType">
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="version" type="xs:string" use="optional"/>
    <xs:attribute name="source" type="xs:string" use="optional"/>
    <xs:attribute name="sha256" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          SHA-256 (64 hex digits, either case) the supplied source must have. The file is hashed
          before it is chained and a mismatch refuses the build. Only valid together with
          source=; a download msis performs is pinned by msis itself. Without it a supplied
          source is chained unverified, with a build warning.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Top-level requires element for declaring runtime dependencies -->
  <xs:complexType name="RequiresType">
    <xs:annotation>
      <xs:documentation>
        Declares a runtime dependency that must be present on the target system.
        MSIS will automatically handle installation via bundle or launch conditions.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="type" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Type of requirement: vcredist, netfx</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="version" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Version of the requirement: 2022, 4.8, etc.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="source" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Optional path to prerequisite installer for offline/custom scenarios</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sha256" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          SHA-256 (64 hex digits, either case) the supplied source must have. The file is hashed
          before it is chained and a mismatch refuses the build. Only valid together with
          source=; a download msis performs is pinned by msis itself. Without it a supplied
          source is chained unverified, with a build warning.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="BundleMsiType">
    <xs:attribute name="source" type="xs:string" use="optional"/>
    <xs:attribute name="source_64bit" type="xs:string" use="optional"/>
    <xs:attribute name="source_32bit" type="xs:string" use="optional"/>
    <xs:attribute name="source_arm64" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="BundleExeType">
    <xs:attribute name="id" type="xs:string" use="optional"/>
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="detect" type="xs:string" use="optional"/>
    <xs:attribute name="args" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="BundleType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="prerequisite" type="PrerequisiteType"/>
        <xs:element name="msi" type="BundleMsiType"/>
        <xs:element name="exe" type="BundleExeType"/>
      </xs:choice>
    </xs:sequence>
    <!-- Legacy shorthand attributes (still supported) -->
    <xs:attribute name="source_64bit" type="xs:string" use="optional"/>
    <xs:attribute name="source_32bit" type="xs:string" use="optional"/>
    <xs:attribute name="source_arm64" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="FeatureType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="feature" type="FeatureType"/>
        <xs:element name="files" type="FilesType"/>
        <xs:element name="registry" type="RegistryType"/>
        <xs:element name="set-env" type="SetEnvType"/>
        <xs:element name="shortcut" type="ShortcutType"/>
        <xs:element name="service" type="ServiceType"/>
        <xs:element name="exclude" type="ExcludeType"/>
        <xs:element name="execute" type="ExecuteType"/>
        <xs:element name="create-folder" type="CreateFolderType"/>
        <xs:element name="remove-on-uninstall" type="RemoveOnUninstallType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="enabled" type="msisBoolean" use="optional"/>
    <xs:attribute name="condition" type="xs:string" use="optional"/>
    <xs:attribute name="allowed" type="msisBoolean" use="optional"/>
  </xs:complexType>

  <!-- Top-level sbom element: a component SBOM supplied by the build (#36) -->
  <xs:complexType name="SBOMType">
    <xs:annotation>
      <xs:documentation>
        Composes a CycloneDX document supplied by the build into the installer's own SBOM.
        MSIS reads the bytes of a payload file but cannot see inside it; the build system that
        produced that file can. The supplied document is merged as received: its components keep
        their own identity, its coverage statements are preserved, and merging one establishes
        nothing about its completeness or accuracy.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="source" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Path to the CycloneDX JSON document, relative to the .msis file</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="for" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Install target of the file the document describes, e.g. [INSTALLDIR]app.exe. It must
          match exactly one installed file; a target matching several is an error, because the
          document would otherwise be attached to an arbitrary one of them.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Top-level component element: facts the script declares about one payload file (#64) -->
  <xs:complexType name="ComponentType">
    <xs:annotation>
      <xs:documentation>
        States what msis cannot read from a payload file's bytes: what it is, which version, who
        created it, under which licence. msis turns the declaration into a supplied SBOM and merges
        it like an sbom element, so every value appears in the installer's SBOM marked as declared
        by this script, never as observed. A declared version that contradicts the version
        resource the package records for the file stops the build.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="for" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Install target of the file, e.g. [INSTALLDIR]libfoo.dll. It must match exactly one installed file.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string" use="optional">
      <xs:annotation><xs:documentation>The component's name as its creator gives it; defaults to the file's name.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="version" type="xs:string" use="optional"/>
    <xs:attribute name="creator" type="xs:string" use="optional">
      <xs:annotation><xs:documentation>The creator's email address, or a URL when there is none.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="license" type="xs:string" use="optional">
      <xs:annotation><xs:documentation>An SPDX licence expression, e.g. MIT or Apache-2.0 OR MIT.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="purl" type="xs:string" use="optional">
      <xs:annotation><xs:documentation>Package URL, e.g. pkg:nuget/Foo@2.3.1.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="cpe" type="xs:string" use="optional">
      <xs:annotation><xs:documentation>CPE 2.3 formatted string or CPE 2.2 URI.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Top-level vex element: the VEX document annotating this product's SBOM (#37) -->
  <xs:complexType name="VEXType">
    <xs:annotation>
      <xs:documentation>
        Names the VEX (Vulnerability Exploitability eXchange) document for this product: the
        team's record of which CVE matches against its components are actually exploitable.
        MSIS assesses nothing - whether a vulnerable path is reachable is a question about your
        source. What it does is check that each statement's recorded conditions still hold for
        the release being built, and flag the ones that do not, so an assessment cannot outlive
        the reason it was true. The evaluated document is written beside the installer's SBOM.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="source" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Path to the CycloneDX VEX JSON document, relative to the .msis file</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="setup">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="set" type="SetType"/>
          <xs:element name="requires" type="RequiresType"/>
          <xs:element name="sbom" type="SBOMType"/>
          <xs:element name="component" type="ComponentType"/>
          <xs:element name="vex" type="VEXType"/>
          <xs:element name="feature" type="FeatureType"/>
          <xs:element name="files" type="FilesType"/>
          <xs:element name="registry" type="RegistryType"/>
          <xs:element name="set-env" type="SetEnvType"/>
          <xs:element name="shortcut" type="ShortcutType"/>
          <xs:element name="service" type="ServiceType"/>
          <xs:element name="exclude" type="ExcludeType"/>
          <xs:element name="execute" type="ExecuteType"/>
          <xs:element name="create-folder" type="CreateFolderType"/>
          <xs:element name="remove-on-uninstall" type="RemoveOnUninstallType"/>
          <xs:element name="bundle" type="BundleType"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="silent" type="msisBoolean" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
